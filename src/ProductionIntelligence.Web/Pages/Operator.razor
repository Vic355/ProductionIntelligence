@page "/operator"

<PageTitle>Operator · @P.Line</PageTitle>

<div class="op">
    <div class="op-head">
        <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;">
            <h1 class="line">@P.Line</h1>
            <span class="muted">@P.Product</span>
        </div>
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;" class="muted">
            <span>@P.Shift</span>
            <span class="num" style="font-size:22px;color:var(--o-text);">@P.Clock</span>
            <span>@P.Crew</span>
        </div>
    </div>

    <div class="op-body">
        <main class="op-main">
            @switch (mode)
            {
                case Mode.Running:
                    <section class="op-panel" aria-live="polite">
                        <div class="spread">
                            <span class="muted" style="font-size:17px;">Needed for the rest of the shift</span>
                            @if (P.Behind)
                            {
                                <span class="op-badge" style="background:var(--o-warn);color:#1A1206;">Behind pace</span>
                            }
                            else
                            {
                                <span class="op-badge" style="background:var(--o-good);color:#062014;">On pace</span>
                            }
                        </div>
                        <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;">
                            <span class="big-pace" style="color:@(P.Behind ? "var(--o-warn)" : "var(--o-good)");">@P.RateNeeded.ToString("0.0")</span>
                            <span class="big-unit">@P.Unit</span>
                        </div>
                        <div class="op-stats">
                            <div><div class="muted small">Running now</div><div class="num">@P.RateNow.ToString("0.0") /min</div></div>
                            <div><div class="muted small">Made so far</div><div class="num">@P.Made.ToString("N0") of @P.Target.ToString("N0")</div></div>
                            <div><div class="muted small">Time left</div><div class="num">@P.TimeLeft</div></div>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:8px;">
                            <div class="op-progress" role="img" aria-label="@($"{P.PercentMade}% made, should be at {P.PercentExpected}%")">
                                <div class="fill" style="width:@(P.PercentMade)%;background:var(--o-warn);"></div>
                                <div class="marker" style="left:@(P.PercentExpected)%;"></div>
                            </div>
                            <div class="spread small muted"><span>@P.PercentMade% made</span><span>White line: where you should be now (@P.ExpectedByNow.ToString("N0"))</span></div>
                        </div>
                        <p style="margin:0;font-size:18px;line-height:1.45;max-width:62ch;">
                            At @P.RateNow.ToString("0.0") a minute you finish about @RoundTo10(P.ProjectedShortfall) packs short.
                            Hold @P.RateNeeded.ToString("0.0") a minute to make target.
                        </p>
                        <div class="muted small" style="margin-top:auto;padding-top:16px;border-top:1px solid var(--o-line);">
                            Last stop 10:52 · core jam · 4 min · fixed with “Reseat cores in loader magazine”
                        </div>
                    </section>
                    break;

                case Mode.Stopped:
                    <section class="op-panel stopped" aria-live="assertive">
                        <div class="spread">
                            <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;">
                                <span class="num" style="font-size:40px;font-weight:700;color:var(--o-crit);">Line stopped · 3 min</span>
                                <span style="font-size:18px;font-weight:600;">Web break at embosser</span>
                            </div>
                            <span class="muted small">3rd time this shift</span>
                        </div>
                        <div class="voice">Voice log 11:42, Chidi: “Paper snapped at the embosser again, jumbo 4471.”</div>
                        <div class="safety">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 3l9.5 17h-19z"></path><path d="M12 10v4"></path><path d="M12 17.5v.5"></path></svg>
                            Lock out the rewinder before you reach in. Never bypass a guard.
                        </div>
                        <div class="muted small">Fixes approved by your shift leader for this stop</div>
                        @foreach (var f in SampleData.WebBreakFixes)
                        {
                            var sel = picked == f.Rank;
                            <div class="fix @(sel ? "sel" : "")">
                                <div class="txt">
                                    <div style="display:flex;gap:10px;align-items:baseline;">
                                        <span class="num" style="font-size:20px;font-weight:700;color:var(--o-accent);">@f.Rank</span>
                                        <span style="font-size:17px;font-weight:600;">@f.Title</span>
                                    </div>
                                    <div style="font-size:14px;color:var(--o-soft);line-height:1.4;">@f.Steps</div>
                                    <div class="xs muted">Worked @f.Worked of @f.Tried times · Source: @f.Source</div>
                                </div>
                                <button class="op-btn @(sel ? "sel" : "")" @onclick="() => picked = f.Rank">@(sel ? "Doing this ✓" : "I'm doing this")</button>
                            </div>
                        }
                        <div class="btns" style="margin-top:auto;justify-content:flex-end;">
                            <button class="op-btn" @onclick="() => calledLeader = true">@(calledLeader ? "Shift leader called" : "Call shift leader")</button>
                            <button class="op-btn go" @onclick="() => mode = Mode.Asking">Line running again</button>
                        </div>
                    </section>
                    break;

                case Mode.Asking:
                    <section class="op-panel center">
                        <span style="color:var(--o-good);font-weight:600;">Running again · stopped 7 min</span>
                        <h2 style="margin:0;font-size:40px;line-height:1.15;font-weight:600;">Did “@UsedFix.Title” fix it?</h2>
                        <p class="muted" style="margin:0;">One tap. Your answer keeps the fix list honest for every shift.</p>
                        <div class="answers">
                            <button class="op-btn huge go" @onclick='() => Answer("yes")'>Yes, fixed</button>
                            <button class="op-btn huge" @onclick='() => Answer("partly")'>Partly</button>
                            <button class="op-btn huge" @onclick='() => Answer("no")'>No</button>
                            <button class="op-btn huge" style="font-size:20px;" @onclick='() => Answer("other")'>Something else fixed it (speak)</button>
                        </div>
                    </section>
                    break;

                case Mode.Done:
                    <section class="op-panel center">
                        <span style="color:var(--o-good);font-weight:600;">Logged · @AnswerLabel</span>
                        <h2 style="margin:0;font-size:40px;font-weight:600;">Thanks, Chidi.</h2>
                        <p style="margin:0;font-size:18px;line-height:1.5;color:var(--o-soft);max-width:60ch;">@DoneText</p>
                        <p style="margin:0;color:var(--o-accent);">+1 complete stop log for Shift A</p>
                        <div><button class="op-btn" @onclick="Reset">Back to pace</button></div>
                    </section>
                    break;
            }
        </main>

        <aside class="op-side">
            <section class="op-card">
                <h3>Shift A this week</h3>
                <div style="display:flex;flex-direction:column;gap:6px;">
                    <div class="spread" style="font-size:14px;"><span style="color:var(--o-soft);">Stop logs complete</span><span class="num" style="font-size:18px;font-weight:600;">@logsComplete of 49</span></div>
                    <div class="op-progress" style="height:8px;"><div class="fill" style="width:@(logsComplete * 100 / 49)%;background:var(--o-accent);"></div></div>
                </div>
                <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
                    <div style="background:var(--o-bg);border-radius:10px;padding:12px;"><div class="num" style="font-size:32px;font-weight:700;">3</div><div class="small muted">problems fixed for good</div></div>
                    <div style="background:var(--o-bg);border-radius:10px;padding:12px;"><div class="num" style="font-size:32px;font-weight:700;">2</div><div class="small muted">fixes shared with other shifts</div></div>
                </div>
            </section>
            <section class="op-card">
                <div class="spread"><h3>Fix credit</h3><span class="num" style="font-size:15px;font-weight:600;color:#062014;background:var(--o-good);padding:3px 10px;border-radius:999px;">+2</span></div>
                <p>Your fix “Check splice tape on a new jumbo before threading” helped Shift C twice on Tuesday night. Both times it worked.</p>
            </section>
            <section class="op-card">
                <h3>Stops this shift</h3>
                <div style="display:flex;gap:18px;"><span class="num" style="font-size:28px;font-weight:700;">@Stops</span><span class="num muted" style="font-size:28px;font-weight:700;">@StopMinutes min</span></div>
                <p class="small">Points come from logging stops, fixing for good and sharing fixes, never from output alone.</p>
            </section>
        </aside>
    </div>

    <div class="op-foot">
        <span>Prototype controls:</span>
        <button class="op-btn slim" @onclick="SimulateStop">Line stops</button>
        <button class="op-btn slim" @onclick="Reset">Reset</button>
    </div>
</div>

@code {
    private enum Mode { Running, Stopped, Asking, Done }

    private static readonly PaceSnapshot P = SampleData.Line3Pace;
    private Mode mode = Mode.Running;
    private int picked;
    private string answer = "";
    private bool calledLeader;
    private int logsComplete = 47;

    private Fix UsedFix => SampleData.WebBreakFixes[Math.Max(picked, 1) - 1];
    private int Stops => mode == Mode.Running && logsComplete == 47 ? 3 : 4;
    private int StopMinutes => mode switch { Mode.Running when logsComplete == 47 => 19, Mode.Stopped => 22, _ => 26 };

    private static int RoundTo10(int n) => (int)(Math.Round(n / 10.0) * 10);

    private string AnswerLabel => answer switch
    {
        "yes" => "Yes, fixed",
        "partly" => "Partly",
        "no" => "No",
        _ => "Something else fixed it",
    };

    private string DoneText => answer switch
    {
        "yes" => $"“{UsedFix.Title}” has now worked {UsedFix.Worked + 1} of {UsedFix.Tried + 1} times. It stays near the top of the list for web breaks.",
        "partly" => "Noted as partly. Your shift leader will see it in the fix review.",
        "no" => "Noted. If this fix keeps failing, it drops down the list and your shift leader reviews it.",
        _ => "Say what fixed it and it goes to your shift leader to approve before anyone else sees it.",
    };

    private void SimulateStop()
    {
        mode = Mode.Stopped;
        picked = 0;
        answer = "";
        calledLeader = false;
    }

    private void Answer(string a)
    {
        answer = a;
        logsComplete = 48;
        mode = Mode.Done;
    }

    private void Reset()
    {
        mode = Mode.Running;
        picked = 0;
        answer = "";
        calledLeader = false;
    }
}

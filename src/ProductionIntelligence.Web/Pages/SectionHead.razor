@page "/section-head"

<PageTitle>Section head · week 45</PageTitle>

<div class="page">
    <div class="page-head">
        <h1>Converting section · Week 45</h1>
        <span class="muted">2–8 Nov 2026 · 6 lines · 3 shifts</span>
    </div>

    <div class="grid-kpi">
        <div class="card kpi"><span class="small muted">Output vs plan</span><span class="val">96.4%</span><span class="small" style="color:var(--good);font-weight:600;">+1.2 pts on week 44</span></div>
        <div class="card kpi"><span class="small muted">Downtime (PLC)</span><span class="val">@SampleData.LineDowntime.Sum(d => d.Hours).ToString("0.0") h</span><span class="small" style="color:var(--good);font-weight:600;">6.0 h less than week 44</span></div>
        <div class="card kpi"><span class="small muted">Weighed waste</span><span class="val">3.8%</span><span class="small" style="color:var(--warn);font-weight:600;">+0.3 pts · from daily weighing reports</span></div>
        <div class="card kpi"><span class="small muted">Repeat losses open</span><span class="val">@SampleData.RepeatLosses.Length</span><span class="small muted" style="font-weight:600;">@SampleData.RepeatLosses.Count(r => r.Tone == Tone.Good) fixed and confirmed by data</span></div>
    </div>

    <div class="tabs" role="tablist">
        @foreach (var (id, label) in tabs)
        {
            <button class="tab @(tab == id ? "active" : "")" role="tab" aria-selected="@(tab == id)" @onclick="() => tab = id">@label</button>
        }
    </div>

    @switch (tab)
    {
        case "digest":
            <div class="grid-3">
                <section class="card">
                    <span class="pill t-good">What improved</span>
                    <p><b>Line 1 core jams fell from 13 stops to 5.</b> The new glue nozzle and cleaning interval from week 42 is holding for three weeks running.</p>
                    <p><b>Line 6 open tails down 70%</b> since Shift C shared the nozzle-tip fix.</p>
                    <span class="xs muted">Sources: PLC stop counts L1, L6 · voice reason codes · action #A-17</span>
                </section>
                <section class="card">
                    <span class="pill t-crit">What got worse</span>
                    <p><b>Line 3 web breaks at the embosser rose from 6 to 14</b>, costing 126 minutes.</p>
                    <p><b>Line 4 log saw jams doubled</b> (9 to 18) after the switch to the new blade supplier on Monday.</p>
                    <span class="xs muted">Sources: PLC stop times · voice transcripts (31) · purchase log</span>
                </section>
                <section class="card">
                    <span class="pill t-info">Likely causes, to check</span>
                    <p>9 of the 14 Line 3 breaks were on jumbos from supplier batch 4471–4479. Operators mention “wet streak” in 4 transcripts. Moisture is a likely cause; QA has not confirmed it yet.</p>
                    <p>Line 4 jams follow blade changes within 40 minutes in 13 of 18 cases.</p>
                    <span class="xs muted">Pattern from 6 weeks of history · treat as a lead, not a finding</span>
                </section>
            </div>
            break;

        case "losses":
            <section class="card" style="padding:8px 8px 14px;">
                <p class="small muted" style="margin:8px 12px 0;">Status is judged from PLC stop data after the countermeasure, not from what the owner reports. Bars show weekly lost minutes, weeks 40–45.</p>
                <div class="scroll-x">
                    <table class="tbl" style="min-width:920px;">
                        <thead><tr><th>Recurring loss</th><th>Line</th><th>Lost this week</th><th>Trend</th><th>Countermeasure and owner</th><th>Result from data</th></tr></thead>
                        <tbody>
                            @foreach (var r in SampleData.RepeatLosses)
                            {
                                var max = r.WeeklyMinutes.Max();
                                <tr>
                                    <td style="font-weight:600;">@r.Issue</td>
                                    <td>@r.Line</td>
                                    <td class="num" style="font-size:18px;font-weight:600;">@r.MinutesThisWeek min</td>
                                    <td>
                                        <div class="spark" role="img" aria-label="@($"Lost minutes weeks 40 to 45: {string.Join(", ", r.WeeklyMinutes)}")">
                                            @for (var i = 0; i < r.WeeklyMinutes.Length; i++)
                                            {
                                                var h = Math.Max(3, (int)Math.Round(r.WeeklyMinutes[i] * 36.0 / max));
                                                var last = i == r.WeeklyMinutes.Length - 1;
                                                <div class="@(last ? $"bg-{r.Tone.Css()}" : "")" style="height:@(h)px;"></div>
                                            }
                                        </div>
                                    </td>
                                    <td><div>@r.Countermeasure</div><div class="xs muted">@r.Owner</div></td>
                                    <td><span class="pill t-@r.Tone.Css()">@r.Status</span><div class="xs muted" style="margin-top:4px;">@r.Note</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div style="padding:0 12px;"><button class="btn">Assign a countermeasure</button></div>
            </section>
            break;

        case "compare":
            <div class="grid-3">
                <section class="card">
                    <h2>Output vs plan by shift</h2>
                    @foreach (var (shift, pct) in SampleData.ShiftOutput)
                    {
                        <div class="hbar">
                            <span style="font-weight:600;">@shift</span>
                            <div class="track"><div class="fill bg-info" style="width:@((pct / 110 * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div><div class="target" style="left:90.9%;"></div></div>
                            <span class="num" style="font-size:18px;font-weight:600;text-align:right;">@pct.ToString("0.0")%</span>
                        </div>
                    }
                    <span class="xs muted">Black line marks 100% of plan. Shift C ran the Line 5 changeovers twice this week.</span>
                </section>
                <section class="card">
                    <h2>Downtime by line, hours</h2>
                    @foreach (var (line, hours) in SampleData.LineDowntime)
                    {
                        <div class="hbar">
                            <span style="font-weight:600;">@line</span>
                            <div class="track"><div class="fill @(hours > 9 ? "bg-warn" : "bg-idle")" style="width:@((hours / 12 * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div></div>
                            <span class="num" style="font-size:18px;font-weight:600;text-align:right;">@hours.ToString("0.0")</span>
                        </div>
                    }
                </section>
                <section class="card span-all">
                    <div class="spread"><h2>Skills overview</h2><span class="small muted">For planning training and buddying, not for ranking people</span></div>
                    <div class="scroll-x">
                        <table class="tbl" style="min-width:640px;">
                            <thead><tr><th>Problem type</th><th>Shift A</th><th>Shift B</th><th>Shift C</th></tr></thead>
                            <tbody>
                                @foreach (var k in SampleData.Skills)
                                {
                                    <tr>
                                        <td style="font-weight:600;">@k.Problem</td>
                                        @foreach (var lvl in k.Levels)
                                        {
                                            var (label, tone) = lvl switch { "S" => ("Handles well", "good"), "L" => ("Learning", "warn"), _ => ("Few cases", "idle") };
                                            <td><span class="pill t-@tone">@label</span></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <span class="xs muted">Handles well: most stops of this type closed in under the median time with an approved fix. Learning: fewer than 3 closed this month.</span>
                </section>
            </div>
            break;

        case "ask":
            <section class="card" style="padding:22px;gap:14px;max-width:980px;">
                <label for="ask-input" style="font-weight:600;">Ask about your lines in plain language</label>
                <form class="btns" @onsubmit="AskTyped" @onsubmit:preventDefault>
                    <input id="ask-input" class="ask-input" type="text" @bind="typed" placeholder="@SampleData.Questions[q].Question" />
                    <button class="btn primary" type="submit" style="min-height:44px;">Ask</button>
                </form>
                <div class="btns">
                    @for (var i = 0; i < SampleData.Questions.Length; i++)
                    {
                        var idx = i;
                        <button class="chip @(q == idx && !unknown ? "active" : "")" @onclick="() => { q = idx; unknown = false; typed = string.Empty; }">@SampleData.Questions[idx].Question</button>
                    }
                </div>
                <div style="border-top:1px solid var(--line-soft);padding-top:14px;display:flex;flex-direction:column;gap:10px;max-width:75ch;">
                    @if (unknown)
                    {
                        <p>In the prototype only the three sample questions have answers. In the real system this would search PLC stops, voice transcripts, handovers and action records, and cite them.</p>
                    }
                    else
                    {
                        @foreach (var para in SampleData.Questions[q].Answer)
                        {
                            <p>@para</p>
                        }
                        <span class="xs muted">Sources: @SampleData.Questions[q].Sources</span>
                    }
                </div>
            </section>
            break;
    }
</div>

@code {
    private readonly (string Id, string Label)[] tabs =
    {
        ("digest", "Weekly digest"),
        ("losses", "Repeat losses"),
        ("compare", "Shifts and lines"),
        ("ask", "Ask"),
    };

    private string tab = "digest";
    private int q;
    private bool unknown;
    private string typed = string.Empty;

    private void AskTyped()
    {
        if (string.IsNullOrWhiteSpace(typed)) return;
        var match = Array.FindIndex(SampleData.Questions, x => x.Question.Equals(typed.Trim(), StringComparison.OrdinalIgnoreCase));
        if (match >= 0) { q = match; unknown = false; }
        else
        {
            // Light keyword routing so typed questions feel real in the demo.
            var t = typed.ToLowerInvariant();
            if (t.Contains("line 3") || t.Contains("l3")) { q = 0; unknown = false; }
            else if (t.Contains("line 4") || t.Contains("clamp") || t.Contains("saw")) { q = 1; unknown = false; }
            else if (t.Contains("handover")) { q = 2; unknown = false; }
            else unknown = true;
        }
    }
}
